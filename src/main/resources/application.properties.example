# ======================================================================
#  Plantilla de configuración segura - Sistema Bancario Core + GestoPago
#  Inyectar secretos mediante variables de entorno o Gestor de Secretos
# ======================================================================

spring.cloud.config.enabled=false
spring.jackson.time-zone=${APP_TIMEZONE:America/Mexico_City}
server.port=${PORT:8080}
# En Render o detras de un proxy TLS confiable usar SERVER_FORWARD_HEADERS_STRATEGY=framework
server.forward-headers-strategy=${SERVER_FORWARD_HEADERS_STRATEGY:none}

# ----------------------------------------------------------------------
# PostgreSQL
# ----------------------------------------------------------------------
spring.datasource.url=${DB_URL}
spring.datasource.username=${DB_USERNAME}
spring.datasource.password=${DB_PASSWORD}
spring.datasource.driver-class-name=org.postgresql.Driver

# ----------------------------------------------------------------------
# Seguridad Criptografica y JWT (Variables de Entorno / Secret Manager)
# ----------------------------------------------------------------------
app.crypto.iv=${APP_CRYPTO_IV}
app.crypto.key=${APP_CRYPTO_KEY}
gestopago.crypto.key=${GESTOPAGO_CRYPTO_KEY:${app.crypto.key}}
gestopago.crypto.iv=${GESTOPAGO_CRYPTO_IV:${app.crypto.iv}}
jwt.secret=${JWT_SECRET}
jwt.expiration=${JWT_EXPIRATION_MS:900000}
jwt.issuer=${JWT_ISSUER:sistema-bancario-core}
jwt.refresh-expiration-ms=${JWT_REFRESH_EXPIRATION_MS:604800000}

# Seguridad de Login (Bloqueo, Rate Limit, TOTP y CORS)
app.auth.max-failed-attempts=${AUTH_MAX_FAILED_ATTEMPTS:5}
app.auth.lockout-minutes=${AUTH_LOCKOUT_MINUTES:15}
app.auth.rate-limit.max-attempts=${AUTH_RATE_LIMIT_MAX_ATTEMPTS:15}
app.auth.rate-limit.window-seconds=${AUTH_RATE_LIMIT_WINDOW_SECONDS:60}
app.auth.trust-forwarded-headers=${AUTH_TRUST_FORWARDED_HEADERS:false}
app.rate-limit.onboarding.max-attempts=${RATE_LIMIT_ONBOARDING_MAX_ATTEMPTS:5}
app.rate-limit.onboarding.window-seconds=${RATE_LIMIT_ONBOARDING_WINDOW_SECONDS:300}
app.rate-limit.images.max-attempts=${RATE_LIMIT_IMAGES_MAX_ATTEMPTS:60}
app.rate-limit.images.window-seconds=${RATE_LIMIT_IMAGES_WINDOW_SECONDS:60}
app.auth.totp.issuer=${AUTH_TOTP_ISSUER:SistemaBancario}
app.auth.totp.challenge-minutes=${AUTH_TOTP_CHALLENGE_MINUTES:5}
app.auth.totp.max-attempts=${AUTH_TOTP_MAX_ATTEMPTS:3}
app.cors.allowed-origins=${APP_CORS_ALLOWED_ORIGINS:http://localhost:3000,http://localhost:8080}

# ----------------------------------------------------------------------
# JPA / Hibernate & Flyway
# ----------------------------------------------------------------------
spring.jpa.open-in-view=false
spring.jpa.hibernate.ddl-auto=none
spring.jpa.show-sql=false
spring.jpa.properties.hibernate.dialect=org.hibernate.dialect.PostgreSQLDialect
spring.flyway.locations=classpath:db/migration
spring.flyway.table=flyway_schema_history
spring.flyway.schemas=public
spring.flyway.baseline-on-migrate=true
spring.flyway.baseline-version=0

# ----------------------------------------------------------------------
# GestoPago - Autenticacion Bearer y Operacion SendTx
# ----------------------------------------------------------------------
gestopago.auth.url=${GESTOPAGO_URL:https://gestopago.portalventas.net}
# Si el gestor de secretos provee directamente el token Bearer:
gestopago.auth.bearer-token=${GESTOPAGO_BEARER_TOKEN:}
gestopago.auth.api-key=${GESTOPAGO_API_KEY:}
# O credenciales para obtencion/renovacion automatica cifrada en reposo:
gestopago.auth.id-distribuidor=${GESTOPAGO_ID_DISTRIBUIDOR}
gestopago.auth.codigo-dispositivo=${GESTOPAGO_CODIGO_DISPOSITIVO}
gestopago.auth.password=${GESTOPAGO_PASSWORD}
gestopago.auth.refresh-rate-ms=${GESTOPAGO_REFRESH_RATE_MS:3600000}

gestopago.tx.unidad=${GESTOPAGO_UNIDAD:${gestopago.auth.codigo-dispositivo}}
gestopago.tx.monto-minimo=${GESTOPAGO_TX_MONTO_MINIMO:1.00}
gestopago.tx.monto-maximo=${GESTOPAGO_TX_MONTO_MAXIMO:50000.00}
gestopago.tx.duplicate-window-seconds=${GESTOPAGO_TX_DUPLICATE_WINDOW_SECONDS:60}
gestopago.tx.conciliacion-inmediata=${GESTOPAGO_TX_CONCILIACION_INMEDIATA:true}
gestopago.tx.conciliacion.cron=${GESTOPAGO_CONCILIACION_CRON:0 */5 * * * *}
gestopago.tx.conciliacion.max-intentos=${GESTOPAGO_CONCILIACION_MAX_INTENTOS:5}
gestopago.tx.conciliacion.en-proceso-timeout-minutes=${GESTOPAGO_CONCILIACION_EN_PROCESO_TIMEOUT_MIN:3}
gestopago.verify.path=${GESTOPAGO_VERIFY_PATH:/sistema/service/verifyTx.do}

# Timeouts Feign
spring.cloud.openfeign.client.config.default.connect-timeout=5000
spring.cloud.openfeign.client.config.default.read-timeout=30000
gestopago.sendtx.connect-timeout-ms=${GESTOPAGO_SENDTX_CONNECT_TIMEOUT_MS:5000}
gestopago.sendtx.read-timeout-ms=${GESTOPAGO_SENDTX_READ_TIMEOUT_MS:15000}

# Catalogo GestoPago & MongoDB
gestopago.catalogo.cron=${GESTOPAGO_CATALOGO_CRON:0 0 6 * * *}
gestopago.catalogo.startup-delay-ms=${GESTOPAGO_CATALOGO_STARTUP_DELAY_MS:3000}
spring.data.mongodb.uri=${MONGODB_URI}

# Actuator, OpenAPI & Logging (sin exponer detalles sensibles)
springdoc.swagger-ui.enabled=${SWAGGER_ENABLED:false}
springdoc.api-docs.enabled=${SWAGGER_ENABLED:false}
app.security.swagger-public=${SWAGGER_PUBLIC:false}
management.endpoints.web.exposure.include=health,info
management.endpoint.health.show-details=when_authorized
logging.level.com.proyecto.servicios=INFO

# Usuario Administrador inicial para revision de onboarding
app.admin.bootstrap.enabled=${ADMIN_BOOTSTRAP_ENABLED:false}
app.admin.bootstrap.correo=${ADMIN_BOOTSTRAP_CORREO:}
app.admin.bootstrap.password=${ADMIN_BOOTSTRAP_PASSWORD:}

# Cliente demo con cuenta de ahorro ACTIVA para QA local
app.demo.cliente.bootstrap.enabled=${DEMO_CLIENTE_BOOTSTRAP_ENABLED:false}
app.demo.cliente.bootstrap.correo=${DEMO_CLIENTE_BOOTSTRAP_CORREO:}
app.demo.cliente.bootstrap.password=${DEMO_CLIENTE_BOOTSTRAP_PASSWORD:}
app.demo.cliente.bootstrap.saldo-inicial=${DEMO_CLIENTE_BOOTSTRAP_SALDO:5000.00}

# Correo Electronico (SMTP / SMTPS por variables de entorno)
spring.mail.host=${SMTP_HOST:}
spring.mail.port=${SMTP_PORT:465}
spring.mail.username=${SMTP_USER:}
spring.mail.password=${SMTP_PASS:}
spring.mail.protocol=smtp
spring.mail.default-encoding=UTF-8
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.ssl.enable=${SMTP_SSL_ENABLE:true}
spring.mail.properties.mail.smtp.ssl.checkserveridentity=true
spring.mail.properties.mail.smtp.ssl.trust=${SMTP_HOST:smtp.gmail.com}
spring.mail.properties.mail.smtp.starttls.enable=${SMTP_STARTTLS_ENABLE:false}
spring.mail.properties.mail.smtp.connectiontimeout=10000
spring.mail.properties.mail.smtp.timeout=10000
spring.mail.properties.mail.smtp.writetimeout=10000
app.mail.enabled=${MAIL_ENABLED:true}
app.mail.from=${SMTP_FROM:${SMTP_USER:}}

# OTP por correo (alternativa/complemento a TOTP)
app.auth.email-otp.expiration-minutes=${AUTH_EMAIL_OTP_MINUTES:5}
app.auth.email-otp.cooldown-seconds=${AUTH_EMAIL_OTP_COOLDOWN_SECONDS:60}
